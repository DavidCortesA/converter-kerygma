{
  "name": "converter-kerygma",
  "productName": "Kerygma Converter",
  "version": "0.2.1",
  "description": "Convertidor de video, audio y fotos para Mac y Windows que funciona sin internet.",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.kerygma.converter",
    "productName": "Kerygma Converter",
    "artifactName": "Kerygma-Converter-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.video"
    },
    "dmg": {
      "title": "Kerygma Converter",
      "artifactName": "Kerygma-Converter-${version}-Mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "3082",
      "installerLanguages": [
        "es_ES"
      ],
      "menuCategory": "Kerygma Converter",
      "shortcutName": "Kerygma Converter",
      "uninstallDisplayName": "Kerygma Converter",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh",
      "artifactName": "Kerygma-Converter-${version}-Windows-Instalador.${ext}"
    },
    "portable": {
      "artifactName": "Kerygma-Converter-${version}-Windows-Portable.${ext}"
    }
  }
}
